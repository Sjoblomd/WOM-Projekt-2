@baseUrl = http://localhost:3001

### Health
GET {{baseUrl}}/health

### Create user
POST {{baseUrl}}/users
Content-Type: application/json

{
  "username": "axel",
  "password": "axel1234"
}

### Login
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "username": "axel",
  "password": "axel1234"
}

### Refresh
POST {{baseUrl}}/users/refresh
Content-Type: application/json

{
  "refreshToken": "PASTE_REFRESH_TOKEN_HERE"
}

### Logout
DELETE {{baseUrl}}/users/refresh
Authorization: Bearer PASTE_REFRESH_TOKEN_HERE
